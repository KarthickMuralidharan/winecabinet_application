# Firebase Configuration - Replace with your actual Firebase project details
# Get these from Firebase Console > Project Settings > General > Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# OpenAI API Key (optional - for AI features)
# Get from https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# Optional: External Wine Database API Keys
# These are optional and the app will work with mock data without them
EXPO_PUBLIC_VIVINO_API_KEY=your_vivino_api_key_here
EXPO_PUBLIC_WINE_SEARCHER_API_KEY=your_wine_searcher_api_key_here
